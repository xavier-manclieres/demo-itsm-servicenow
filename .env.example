# Copier ce fichier en .env puis renseigner les valeurs. Ne jamais commiter .env.

# Base de données n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changer-moi
POSTGRES_DB=n8n

# Clé de chiffrement des identifiants stockés par n8n (générer : openssl rand -hex 32)
N8N_ENCRYPTION_KEY=changer-moi

# URL publique des webhooks (utile pour la Business Rule ServiceNow)
N8N_WEBHOOK_URL=http://localhost:5678/

# Jeton partagé entre la Business Rule ServiceNow et le webhook n8n
WEBHOOK_TOKEN=changer-moi
