    {
      "id": "b510ce9c-072e-4e2d-adc0-56828d10d127",
      "name": "Un élément par incident",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Pour chaque problème créé, produit un élément par incident à rattacher.\n// Jira : la réponse de création renvoie la clé du ticket (IT-83), utilisée comme identifiant et comme numéro.\nconst out = [];\n$input.all().forEach((p, i) => {\n  const c = $('Candidat validé').itemMatching(i).json;\n  const f = c.fields || c;\n  const ids = String(f['IDs incidents'] || '')\n    .split(',')\n    .map((s) => s.trim())\n    .filter(Boolean);\n  for (const incidentId of ids) {\n    out.push({ json: {\n      incidentId,\n      problemId: p.json.key,\n      problemNumber: p.json.key,\n      recordId: c.id,\n    }});\n  }\n});\nreturn out;"
      }
    },
    {
      "id": "bc497857-e4cd-48b9-8765-e1d19b0d7dd9",
      "name": "Rattacher l'incident",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://xavier-itsm.atlassian.net/rest/api/3/issueLink",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: { name: \"Problem/Incident\" }, outwardIssue: { key: $json.incidentId }, inwardIssue: { key: $json.problemId } }) }}"
      }
    },
    {
      "id": "17a3af80-1f1d-480e-b6fe-ae8667121985",
      "name": "Un élément par candidat",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Une fois tous les incidents rattachés, un seul élément par candidat\n// pour mettre à jour Airtable (statut Créé + numéro du problème).\nconst vus = new Map();\nfor (const { json: r } of $('Un élément par incident').all()) {\n  if (!vus.has(r.recordId)) {\n    vus.set(r.recordId, { recordId: r.recordId, problemNumber: r.problemNumber, nbRattaches: 0 });\n  }\n  vus.get(r.recordId).nbRattaches += 1;\n}\nreturn [...vus.values()].map((json) => ({ json }));"
      }
    },
