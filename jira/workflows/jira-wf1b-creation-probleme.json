        "jsonBody": "={{ JSON.stringify({ fields: { project: { key: \"IT\" }, issuetype: { id: \"10007\" }, summary: $json.fields[\"Titre proposé\"], labels: [\"demo-itsm\"], description: { type: \"doc\", version: 1, content: [{ type: \"paragraph\", content: [{ type: \"text\", text: $json.fields[\"Hypothèse\"] || \"\" }] }, { type: \"paragraph\", content: [{ type: \"text\", text: \"Incidents rattachés : \" + ($json.fields[\"Incidents\"] || \"\") }] }, { type: \"paragraph\", content: [{ type: \"text\", text: \"Créé par la démo ITSM après validation humaine dans Airtable.\" }] }] } } }) }}"
      }
