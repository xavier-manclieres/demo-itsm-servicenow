    {
      "id": "6842f2f9-d0f0-442d-890a-94b518b05d22",
      "name": "Préparer les REX",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        112
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Pour chaque incident P1 résolu sans REX : chronologie (notes de travail et\n// commentaires), durée, et masquage des données sensibles avant l'envoi au modèle.\nconst dejaRediges = new Set(\n  $('Lire les REX existants').all().map((i) => i.json.Incident).filter(Boolean)\n);\n\nconst enDate = (s) => new Date(String(s).replace(' ', 'T') + 'Z');\n\n// Masque adresses IP et secrets passés en clair. Les noms d'hôtes ne sont pas\n// masqués ici : en entreprise, une liste de motifs propre au SI s'ajoute.\nconst masquer = (t) => String(t || '')\n  .replace(/\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b/g, '[IP]')\n  .replace(/\\b(password|passwd|pwd|mot de passe|token|secret)(\\s*[:=]\\s*)\\S+/gi, '$1$2[MASQUÉ]')\n  .replace(/(--pass(?:word)?[=\\s]+)\\S+/gi, '$1[MASQUÉ]')\n  .replace(/(\\s-p)(?=\\S)\\S+/g, '$1[MASQUÉ]');\n\nconst notesParIncident = {};\nfor (const { json: n } of $input.all()) {\n  if (!n.element_id) continue;\n  (notesParIncident[n.element_id] ||= []).push(n);\n}\n\nconst out = [];\nfor (const { json: inc } of $('Incidents P1 résolus').all()) {\n  if (!inc.sys_id || dejaRediges.has(inc.number)) continue;\n\n  const notes = (notesParIncident[inc.sys_id] || [])\n    .slice()\n    .sort((a, b) => String(a.sys_created_on).localeCompare(String(b.sys_created_on)));\n\n  // Les intervenants deviennent « Intervenant 1, 2… » : aucun nom n'est envoyé au modèle.\n  const alias = {};\n  const pseudo = (u) => (alias[u] ||= `Intervenant ${Object.keys(alias).length + 1}`);\n\n  const chronologie = notes\n    .map((n) => `${n.sys_created_on} UTC, ${pseudo(n.sys_created_by)} : ${masquer(n.value)}`)\n    .join('\\n');\n\n  out.push({ json: {\n    sys_id: inc.sys_id,\n    number: inc.number,\n    short_description: masquer(inc.short_description),\n    close_notes: masquer(inc.close_notes),\n    chronologie: chronologie || 'Aucune note de travail.',\n    duree: Math.round((enDate(inc.resolved_at) - enDate(inc.opened_at)) / 60000),\n    nbNotes: notes.length,\n  }});\n}\nreturn out;"
      }
    },
    {
      "id": "946b130f-ab4a-4aac-8683-a3fb137b2a2c",
      "name": "Rédiger le REX",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1120,
        112
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Rédige le brouillon de REX de l'incident {{ $json.number }}\n« {{ $json.short_description }} », durée {{ $json.duree }} minutes.\n\nChronologie (notes de travail et commentaires) :\n{{ $json.chronologie }}\n\nNotes de résolution : {{ $json.close_notes }}\n\nStructure obligatoire :\n1. Résumé, en 3 phrases\n2. Impact\n3. Chronologie horodatée\n4. Cause racine\n5. Actions immédiates\n6. Actions préventives proposées\n\nRègles : n'invente rien ; si une information manque, écris « à confirmer » ;\nton factuel, phrases courtes."
      }
    },
