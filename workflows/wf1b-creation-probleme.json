    {
      "id": "b510ce9c-072e-4e2d-adc0-56828d10d127",
      "name": "Un élément par incident",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Pour chaque problème créé, produit un élément par incident à rattacher.\nconst out = [];\n$input.all().forEach((p, i) => {\n  const c = $('Candidat validé').itemMatching(i).json;\n  const f = c.fields || c;\n  const ids = String(f['IDs incidents'] || '')\n    .split(',')\n    .map((s) => s.trim())\n    .filter(Boolean);\n  for (const incidentId of ids) {\n    out.push({ json: {\n      incidentId,\n      problemId: p.json.sys_id,\n      problemNumber: p.json.number,\n      recordId: c.id,\n    }});\n  }\n});\nreturn out;"
      }
    },
    {
      "id": "bc497857-e4cd-48b9-8765-e1d19b0d7dd9",
      "name": "Rattacher l'incident",
