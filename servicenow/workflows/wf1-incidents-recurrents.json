      "name": "Incidents des 30 derniers jours",
      "type": "n8n-nodes-base.serviceNow",
      "typeVersion": 1,
      "position": [
        448,
        144
      ],
      "parameters": {
        "resource": "incident",
        "operation": "getAll",
        "authentication": "basicAuth",
        "returnAll": true,
        "options": {
          "sysparm_query": "opened_at>=javascript:gs.daysAgoStart(30)^problem_idISEMPTY",
          "sysparm_display_value": "true",
          "sysparm_exclude_reference_link": true,
          "sysparm_fields": [
            "sys_id",
            "number",
            "short_description",
            "category",
            "cmdb_ci",
            "opened_at"
          ]
        }
      },
      "executeOnce": true
    },
    {
      "id": "ae818165-fcf1-44c9-8f47-28090bffff77",
      "name": "Regrouper et comparer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        144
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Regroupe les incidents par CI + catégorie (groupes de 3 ou plus)\n// et repère les signatures déjà présentes dans Airtable.\nconst SEUIL = 3;\n\nconst existants = {};\nfor (const { json: r } of $('Lire les candidats existants').all()) {\n  if (r.Signature) existants[r.Signature] = { id: r.id, statut: r.Statut || '' };\n}\n\nconst nomCi = v => (v && typeof v === 'object') ? (v.display_value || v.value || '') : (v || '');\n\nconst groupes = {};\nfor (const { json: i } of $input.all()) {\n  const ci = nomCi(i.cmdb_ci);\n  if (!ci) continue;\n  const cle = `${ci} | ${i.category}`;\n  (groupes[cle] ||= []).push({ ...i, ci });\n}\n\nreturn Object.entries(groupes)\n  .filter(([, l]) => l.length >= SEUIL)\n  .map(([signature, l]) => ({ json: {\n    signature,\n    ci: l[0].ci,\n    categorie: l[0].category,\n    nb: l.length,\n    incidents: l.map(i => i.number).join(', '),\n    ids: l.map(i => i.sys_id).join(','),\n    descriptions: l.map(i => `${i.number} : ${i.short_description}`).join('\\n'),\n    recordId: existants[signature]?.id || '',\n    statutExistant: existants[signature]?.statut || '',\n  }}));"
      }
    },
